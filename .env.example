# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）
DATABASE_URL=

# 認証は Supabase Auth（Google）。フロントエンドへ出るのは publishable key のみで、
# service_role キーはリポジトリにも VPS にも置かない。
# 本番の値は organization 共通の GitHub variables
# （SUPABASE_PROJECT_URL / SUPABASE_PUBLISHABLE_KEY）から渡る。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可する Google アカウント（カンマ区切りで複数可）。
# **未設定の場合は誰もログインできない。**
ALLOWED_EMAIL=

# 公開URL。アプリからは参照しないが、Supabase の Redirect URLs 登録と
# Apache VirtualHost の生成で使う本番URLの正。
AUTH_URL=

# サーバー間参照用API（/api/internal/*）の共有シークレット。
# 未設定の間、このAPIは 503 を返して無効になる。詳細は docs/internal-api.md
INTERNAL_API_KEY=

# ログイン通知（任意。未設定なら通知しない）
SIGNALY_LOGIN_WEBHOOK_URL=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=
