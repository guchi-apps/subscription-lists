# cp .env.local.example .env.local
#
# ローカル開発用。1Password は不要（本番の値はGitHubのsecret/variableから注入する。
# どの値をどこから取るかは .github/secrets-manifest.tsv を参照）。

DATABASE_URL=mysql://subscribe_lists:devpassword@127.0.0.1:3306/app_subscribe_lists_dev

# Supabase Auth（**開発用**のSupabaseプロジェクト。本番とは別プロジェクト）。
#   1Password の Supabase 開発用アイテムにある project-url / publishable-key を貼り付ける。
#   ローカル開発で1Passwordに依存しないよう、ここへ直接値を書く（このファイルはGit管理対象外）。
#   Supabaseダッシュボードの Authentication > URL Configuration > Redirect URLs に
#   http://localhost:3000/auth/callback を登録しておくこと（ポートを変えるならそれに合わせる）。
#   スマホからLAN経由で確認する場合は http://<LAN-IP>.sslip.io:3000/auth/callback も追加する
#   （生のLAN IPはGoogleが拒否する）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可するGoogleアカウント（カンマ区切りで複数可）。
# **未設定の場合は誰もログインできない。**
ALLOWED_EMAIL=kazu9sum.mi@gmail.com

# 画面確認用の認証バイパス。true の間だけログイン済み扱いになり、DBの先頭ユーザーとして
# 画面・APIを確認できる（GUIの無いsubpcからOAuthを完了できないため）。
#   NODE_ENV=production では常に無効。確認が終わったらコメントアウトに戻す。
# DISABLE_AUTH=true

# サーバー間参照用API（/api/internal/*）の共有シークレット。
# ローカルでこのAPIを叩くときだけ必要（未設定なら 503 を返して無効）。
# 本番の値は使わず、`openssl rand -base64 32` 等でローカル用の適当な値を入れる。
INTERNAL_API_KEY=

# ログイン通知（任意。未設定なら通知しない。ローカルでは空のままでよい）
SIGNALY_LOGIN_WEBHOOK_URL=
