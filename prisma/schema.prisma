generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- NextAuth.js / Auth.js v5 ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
}

// --- Application models ---

enum BillingCycle {
  MONTHLY
  YEARLY
}

model PaymentMethod {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // 例: "楽天カード", "口座振替"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([userId, name])
  @@index([userId, displayOrder])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String // サブスク名

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  startDate DateTime  @db.Date // 契約開始日
  endDate   DateTime? @db.Date // 契約終了日(null=自動更新中。未来日=解約予定。過去日=解約済み)
  memo      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceChanges SubscriptionPrice[]

  @@index([userId])
  @@index([paymentMethodId])
}

// サブスクの料金改定履歴。「いつから・いくら」を複数保持することで、
// 途中の値上げ/値下げや支払い周期変更を記録に残したまま追跡できるようにする。
model SubscriptionPrice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount       Decimal      @db.Decimal(10, 2) // 1回あたりの請求額
  billingCycle BillingCycle @default(MONTHLY)
  billingDay   Int // 支払日(1-31)
  billingMonth Int? // YEARLY のときのみ使用(1-12)

  effectiveFrom DateTime @db.Date // この金額が適用され始めた日

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, effectiveFrom])
  @@index([subscriptionId, effectiveFrom])
}
